{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix app ci",
  "buildCommand": "npm --prefix app run build",
  "outputDirectory": "app/dist",
  "functions": {
    "api/engine.py": {
      "includeFiles": "{graphrag/**,catalog/data/*.json}",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/v1/:route*", "destination": "/api/engine?route=:route*" }]
}
